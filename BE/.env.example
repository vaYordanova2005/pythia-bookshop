# PostgreSQL connection string. Local example below; for a hosted DB (e.g. Neon)
# use its connection string and keep ?sslmode=require.
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/pythia

PORT=5173

# Required — the server refuses to start without this. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Comma-separated CORS allow-list. Defaults to http://localhost:<PORT> if unset.
ALLOWED_ORIGINS=http://localhost:5173
